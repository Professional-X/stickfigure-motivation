# === GitHub PAT — used ONCE by setup_secrets.py to push other secrets ===
# After running setup, ROTATE this immediately at https://github.com/settings/tokens
# Required scopes: repo, workflow
GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === LLM: OpenRouter (https://openrouter.ai/keys) ===
# Free model: nvidia/nemotron-3-ultra-550b-a55b:free (550B params, 1M context)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Image gen: HuggingFace (https://huggingface.co/settings/tokens) ===
# Create a "Read" token. Free tier rate-limits to ~1 req/sec sustained.
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Upload: Composio (https://composio.dev) ===
# API key is generated in Composio dashboard
# Entity ID = your "Connected Account ID" (starts with ca_) shown after linking YouTube
COMPOSIO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
COMPOSIO_ENTITY_ID=ca_xxxxxxxxxxxxxxxxxxxxxxxx

# === Optional: override defaults ===
# LLM_PROVIDER=openrouter            # (default) — or 'nvidia' to use NVIDIA Build
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# IMAGE_PROVIDER=huggingface         # (default) — or 'nvidia' to use NVIDIA Build Flux

# === Local dev only (GitHub Actions doesn't need this) ===
VIDEO_OUTPUT_DIR=./output
